  "narrative": {
    "northStar": "Et åbent redaktionelt klippebord",
    "overview": "Varmt, åbent redaktionelt design med store groteske overskrifter, filmisk fotografi og varm rød som klippemarkør. Papir, blæk og luft bærer læsningen; mørke billedsektioner og en rød kontaktflade giver tydelige skift i rytmen.\n\nVerdenen er implementeret i kode efter ejerens delegering uden interview. Dokumentet registrerer den lokale implementering, ikke en kundegodkendt komposition. Frontmatter er de normative, genbrugte tokenværdier; størrelsernes responsive afvigelser beskrives nedenfor.",
    "keyCharacteristics": [
      "Åbne flader og tynde skillelinjer frem for svævende kort.",
      "Instrument Sans til store overskrifter; Manrope til læsning og betjening.",
      "Fotografiske koncepter med tydelig mærkning og præcise formatmarkører.",
      "Synlig servertekst og bevægelse som en progressiv forbedring."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Brug den varme røde som systemets eneste accent; store røde flader er tilladt i kontaktsektionen.",
        "section": "colors"
      },
      {
        "name": "The Whole Word Rule",
        "body": "Lad overskrifter skalere og ombryde mellem ord; undgå brud midt i ord.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Skab struktur med luft, farveflader og linjer; kort og indhold får ikke kontrolknappens skygge.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do brug papir og blæk som læseflade og varm rød til betoning og handling.",
      "Do behold store overskrifter hele og læsbare på små skærme.",
      "Do mærk koncepter og illustrationsfotos tydeligt, indtil reelt kundearbejde findes.",
      "Do bevar servertekst, tastaturfokus, brugerens pausevalg og reduced motion."
    ],
    "donts": [
      "Don't indføre gradienter, dekorative småoverskrifter eller monospace-kostume.",
      "Don't opfinde kundebeviser, portrætter, priser eller tidligere designgodkendelser.",
      "Don't gøre de runde tags og bevægelseskontrollen til en generel rund kortstil.",
      "Don't gøre desktop-parallax nødvendig for forståelsen af indholdet."
    ]
  }
